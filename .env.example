APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Left unset, the session cookie is Secure everywhere except APP_ENV=local, and
# SameSite=Strict everywhere. Set these only to deliberately weaken that — for
# instance a staging box that genuinely has no TLS.
# SESSION_SECURE_COOKIE=false
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# The URL prefix the whole private workspace (content editor + planning
# calendar) sits behind. "/" stays the public visit card, and nothing links to
# this path. The login page lives here too, at <ADMIN_PATH>/login — there is
# no /login — so this is the URL to bookmark for signing in.
#
# Set your own before going live. Do NOT derive it from anything on the public
# page, such as the initials shown there: that is the first thing somebody
# would try. Generate a random one instead:
#
#   php -r "echo 'workspace-'.bin2hex(random_bytes(4)).PHP_EOL;"
#
# Run `php artisan route:clear` after changing it.
ADMIN_PATH=change-me-before-going-live

# Seeded by AdminUserSeeder (php artisan db:seed) as the one workspace login.
# The seeder refuses to run outside local development unless ADMIN_PASSWORD is
# set and long enough, so these placeholders cannot reach a live install.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
